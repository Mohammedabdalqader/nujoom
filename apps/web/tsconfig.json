{
  "extends": "@nujoom/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
