# Local development defaults. Committed on purpose: no secrets here.
# `npx expo start` runs the DEMO build: labelled sample players, pitches and images, no backend.
#
# To run against the real Supabase project instead, create `.env.development.local` (git-ignored):
#   EXPO_PUBLIC_APP_VARIANT=production
#   EXPO_PUBLIC_SUPABASE_URL=https://lowqyfbmzeixnadamezx.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase projects api-keys`>
# then restart with `npx expo start --clear`.
EXPO_PUBLIC_APP_VARIANT=demo
